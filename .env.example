SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key
PORT=3000

# Claude API (já instalado: @anthropic-ai/sdk)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Concierge via Twilio
# 1. Criar conta em twilio.com/whatsapp
# 2. Ativar sandbox em Messaging > Try it out > Send a WhatsApp message
# 3. Configurar webhook: POST https://takko-api.onrender.com/webhook/whatsapp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_WHATSAPP_FROM=+14155238886  # número do sandbox Twilio (ou número comprado)

# URL pública do frontend (para os links nos anúncios criados pelo concierge)
SITE_URL=https://takko-catch-clean.lovable.app

# Seu número pessoal (com DDI, sem +) — recebe preview de cada anúncio para aprovar
# Ex: 5541999999999
OPERATOR_WHATSAPP=55xxxxxxxxxxx

# Notificação por email (Gmail) — backup/substituto do WhatsApp do operador
# Crie uma App Password em: myaccount.google.com/apppasswords
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
OPERATOR_EMAIL=andreyhigashi@gmail.com
